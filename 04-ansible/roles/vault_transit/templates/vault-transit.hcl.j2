# Transit Vault on {{ backup_vm_name }}: holds the key that unseals the
# cluster's Vault (issue #3). Managed by Ansible (role vault_transit).
storage "file" {
  path = "/vault/file"
}

listener "tcp" {
  address         = "0.0.0.0:8200"
  tls_cert_file   = "/vault/config/tls.crt"
  tls_key_file    = "/vault/config/tls.key"
  tls_min_version = "tls12"
}

api_addr = "https://{{ backup_ip }}:{{ vault_transit_port }}"
ui       = false
